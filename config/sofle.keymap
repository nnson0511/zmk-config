#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |  DEL  |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | CTRL  |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | MUTE  |  N   |  M    |  ,    |  .   |   /   | ENTER |
//               | GUI | ALT  | LOWER| SPACE|  HOME  |  |  END  | SPACE| RAISE | ALTGR | CTRL  |
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                      &kp N6 &kp N7    &kp N8    &kp N9   &kp N0    &kp BSPC
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                       &kp Y  &kp U     &kp I     &kp O    &kp P     &kp DEL
&kp LSHFT &kp A  &kp S  &kp D    &kp F    &kp G                       &kp H  &kp J     &kp K     &kp L    &kp SEMI  &kp SQT
&kp LCTRL &kp Z  &kp X  &kp C    &kp V    &kp B  &kp C_MUTE &kp C_MUTE &kp N &kp M     &kp COMMA &kp DOT  &kp FSLH  &kp RET
                 &kp LGUI &kp LALT &mo 1  &kp SPACE  &kp HOME   &kp END &kp SPACE &mo 2    &kp RALT  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp DOWN UP &inc_dec_kp RIGHT LEFT>;
        };

        lower_layer {
            display-name = "LOWER";
// ------------------------------------------------------------------------------------------------------------
// |   `   |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |       | RET |  UP |      |      |      |                   |      |       |  UP   |  -   |   =   |  F12  |
// | CAPS  | LEFT| DOWN| RIGHT|      |      |                   |  6   | LEFT  | DOWN  | RIGHT|   0   |   \   |
// |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  {   |  }    |   ;   |   ;   |   \   |       |
//              |BOOTLDR|     |      |      |        |  |       |      |       |       |      |
            bindings = <
&kp GRAVE &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                      &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
&trans    &kp RET   &kp UP    &trans    &trans    &trans                      &trans    &trans    &kp UP    &kp MINUS &kp EQUAL &kp F12
&kp CLCK  &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans                      &kp N6    &kp LEFT  &kp DOWN  &kp RIGHT &kp N0    &kp BSLH
&trans    &kp EQUAL &kp MINUS &kp PLUS  &kp LBRC  &kp RBRC  &trans   &trans   &kp LBRC  &kp RBRC  &kp SEMI  &kp SEMI  &kp BSLH  &trans
                    &bootloader &trans  &trans    &trans    &trans   &trans   &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "RAISE";
// ------------------------------------------------------------------------------------------------------------
// | BT_CLR| BT1 | BT2 | BT3  | BT4  | BT5  |                   |OUT_TOG|      |       |      |   -   |   =   |
// | UNLOCK| INS | PRSC| APPL |      |      |                   |      |       |  UP   |  [   |   }   |       |
// | CAPS  |     |     |      |      |      |                   |      | LEFT  | DOWN  | RIGHT|   {   |       |
// |       |     |     |      |      |      |        |  |       |      | PREV  | PLAY  | NEXT |       | SHIFT |
//                 |     |      |      |      |        |  |       |      |       |       |BOOTLDR|
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &out OUT_TOG &trans &trans &trans &kp MINUS &kp EQUAL
&studio_unlock &kp INS  &kp PSCRN &kp K_APP &trans    &trans                      &trans    &trans    &kp UP    &kp LBKT  &kp RBRC  &trans
&kp CLCK  &trans    &trans    &trans    &trans    &trans                      &trans    &kp LEFT  &kp DOWN  &kp RIGHT &kp LBRC  &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans   &trans   &trans    &kp C_PREV &kp C_PP &kp C_NEXT &trans   &kp RSHFT
                    &trans    &trans    &trans    &trans    &trans   &trans   &trans    &trans    &trans    &bootloader
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
