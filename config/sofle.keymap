#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    sensors {
        status = "okay";
        sensors = <&left_encoder &right_encoder>;
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
// ------------------------------------------------------------------------------------------------------------
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
// |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |  DEL  |
// |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | MUTE  |  N   |  M    |  ,    |  .   |   /   | ENTER |
//               | CTRL| ALT  | GUI  | LOWER|  SPACE |  | RAISE | GUI  | ALTGR | CTRL  |
            bindings = <
&kp GRAVE &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                      &kp N6 &kp N7    &kp N8    &kp N9   &kp N0    &kp BSPC
&kp ESC   &kp Q  &kp W  &kp E    &kp R    &kp T                       &kp Y  &kp U     &kp I     &kp O    &kp P     &kp DEL
&kp TAB   &kp A  &kp S  &kp D    &kp F    &kp G                       &kp H  &kp J     &kp K     &kp L    &kp SEMI  &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B  &kp C_MUTE &kp C_MUTE &kp N &kp M     &kp COMMA &kp DOT  &kp FSLH  &kp RET
                 &kp LCTRL &kp LALT &kp LGUI &lt 1 LBKT &kp SPACE  &lt 2 RBKT &kp RGUI &kp RALT &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp DOWN UP &inc_dec_kp RIGHT LEFT>;
        };

        lower_layer {
            display-name = "LOWER";
// ------------------------------------------------------------------------------------------------------------
// |   `   |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |       | RET |  UP |      |      |      |                   |      |       |  UP   |  -   |   =   |  F12  |
// | CAPS  | LEFT| DOWN| RIGHT|      |      |                   |  6   | LEFT  | DOWN  | RIGHT|   0   |   \   |
// |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  {   |  }    |   ;   |   ;   |   \   |       |
//                 |     |      |      |      |        |  |       |      |       |       |
            bindings = <
&kp GRAVE &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                      &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
&trans    &kp RET   &kp UP    &trans    &trans    &trans                      &trans    &trans    &kp UP    &kp MINUS &kp EQUAL &kp F12
&kp CLCK  &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans                      &kp N6    &kp LEFT  &kp DOWN  &kp RIGHT &kp N0    &kp BSLH
&trans    &kp EQUAL &kp MINUS &kp PLUS  &kp LBRC  &kp RBRC  &trans   &trans   &kp LBRC  &kp RBRC  &kp SEMI  &kp SEMI  &kp BSLH  &trans
                    &trans    &trans    &trans    &trans    &trans   &trans   &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "RAISE";
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |     | INS | PRSC | APPL |      |                   |      |       |       |      |   -   |   =   |
// | CAPS  |     |     |      |      |      |                   |      |       |  UP   |      |   {   |   }   |
// |       |     |     |      |      |      |        |  |       |      | LEFT  | DOWN  | RIGHT|       |       |
//                 |     |      |      |      |        |  | HOME | PLAY |  END  |       | SHIFT|
            bindings = <
&trans    &trans    &trans    &trans    &trans    &trans                      &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &kp INS   &kp PSCRN &kp K_APP &trans                      &trans    &trans    &trans    &trans    &kp MINUS &kp EQUAL
&kp CLCK  &trans    &trans    &trans    &trans    &trans                      &trans    &trans    &kp UP    &trans    &kp LBRC  &kp RBRC
&trans    &trans    &trans    &trans    &trans    &trans    &trans   &trans   &trans    &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans
                    &trans    &trans    &trans    &trans    &trans   &kp HOME &kp C_PP  &kp END   &trans    &kp RSHFT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
